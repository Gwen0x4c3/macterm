.DS_Store
.claude/
.codegraph/

# Ghostty resources downloaded by setup.sh from the thdxg/ghostty release,
# mirroring a real Ghostty.app layout
GhosttyKit.xcframework
Macterm/Resources/*
!Macterm/Resources/.gitkeep
# Macterm's own bundled shaders (Settings → Experimental), not a download.
!Macterm/Resources/shaders/
# Records which pinned release the two artifacts above came from, so bumping
# GHOSTTYKIT_TAG in setup.sh refreshes them instead of the presence checks
# silently keeping the old copy. Per-checkout state, not source.
.ghosttykit-tag
.zmx-tag

build/
__pycache__/
.pytest_cache/

# Generated by xcodegen from project.yml
Macterm.xcodeproj/


.env*
!.env.example

# The demo recorder generates an ssh keypair for its throwaway container; the
# recordings themselves live outside the repo (see scripts/record-demos).
scripts/record-demos/remote/id_ed25519*
scripts/record-demos/remote/authorized_keys

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
